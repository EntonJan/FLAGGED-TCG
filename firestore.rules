rules_version = '2';

// =====================================================================
// FLAGGED - Firestore Security Rules
// =====================================================================
// Deckt zwei Bereiche ab:
//   1. Bestehende Collections (decks, matches) - unveraendertes Verhalten,
//      nur explizit als Regeln festgehalten (vorher evtl. "Test-Modus").
//   2. NEU: users (Coins), inventory (Kartenbesitz), shop (Rotation).
//
// WICHTIG ZUR SICHERHEIT (bewusste Entscheidung, siehe unten):
// Fuer users/{uid} und inventory/{uid} gibt es HIER ABSICHTLICH KEIN
// "allow update". Ein Kaufvorgang veraendert immer BEIDE Dokumente
// gleichzeitig (Coins runter, Inventar hoch), und das kann eine reine
// Firestore-Regel nicht dokumentuebergreifend atomar und faelschungssicher
// pruefen. Bis es eine Cloud Function (oder eine vergleichbare serverseitige
// Instanz) fuer den Kauf gibt, bleibt der Bestand nach der Erstanlage fix.
// Das ist bewusst restriktiv statt "irgendwie halb sicher" - lieber der
// Shop wartet auf die Cloud Function, als dass Coins/Karten manipulierbar
// sind, sobald es um physische Packs und echtes Geld geht.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Bestehend: Decks
    // -------------------------------------------------------------
    match /decks/{deckId} {
      allow read: if request.auth != null &&
                     (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);

      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if request.auth != null &&
                                resource.data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Bestehend: Matches
    // -------------------------------------------------------------
    match /matches/{matchId} {
      // Bewusst nicht verschaerft gegenueber dem bisherigen Verhalten,
      // damit laufende/bestehende Partien nicht brechen.
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------
    // NEU: users/{uid} - aktuell nur der Coin-Kontostand
    // -------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Anlegen nur fuer den eigenen Account, und nur mit coins == 0 --
      // verhindert, dass sich jemand beim ersten Login direkt Coins gutschreibt.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins == 0;

      // Bewusst KEIN allow update -- siehe Hinweis oben. Sobald der Shop/
      // Kaufvorgang steht, muss das ueber eine Cloud Function oder eine
      // sehr genau gepruefte serverseitige Transaktion laufen, NICHT ueber
      // einen einfachen Client-Write. Bis dahin bleibt update gesperrt.
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // NEU: inventory/{uid} - besessene Kartenkopien, { cards: {cardId: count} }
    // -------------------------------------------------------------
    match /inventory/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Anlegen nur fuer den eigenen Account, und nur mit einer leeren
      // Karten-Map -- verhindert, dass sich jemand beim ersten Login
      // direkt Karten gutschreibt.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.cards == {};

      // Auch hier: KEIN allow update, aus demselben Grund wie bei users/.
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // NEU: shop/current - die aktuelle Rotation (rein lesend fuer Clients)
    // Struktur (Vorschlag):
    //   { cycleId: "2026-W05", startsAt, endsAt,
    //     offers: { "005": { rarity: "common", price: 40, stock: 2, sold: 0 } } }
    // -------------------------------------------------------------
    match /shop/{docId} {
      allow read: if request.auth != null;

      // Schreiben (Anlegen der naechsten Rotation, Lagerbestand runterzaehlen
      // bei einem Kauf) ausschliesslich ueber eine Cloud Function, nie direkt
      // vom Client -- aus demselben Grund wie bei users/inventory oben.
      allow write: if false;
    }

    // -------------------------------------------------------------
    // NEU: Admin-Gate fuer Kartenpflege (Base44-Sync-Review im "Admin"-Tab).
    //
    // WICHTIG: Das Verstecken des Tabs im UI (siehe index.html, isAdminUser())
    // ist NUR Komfort, keine Sicherheit -- jeder koennte per Devtools trotzdem
    // versuchen, direkt gegen Firestore zu schreiben. Die eigentliche Grenze
    // ist hier: nur genau dieser eine, per E-Mail verifizierte Account darf
    // schreiben. Bewusst eine feste E-Mail statt einer Rollen-Collection,
    // weil es aktuell exakt 1 Admin gibt -- eine Rollen-Collection waere hier
    // nur Komplexitaet ohne Mehrwert.
    // -------------------------------------------------------------
    function isCardAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jdenkelmann@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // cards/{cardId}: vom Admin-Bereich gepflegte Kartendaten (Spiegel der in
    // index.html fest einkompilierten CARDS_DATA, angereichert um i18n-Felder
    // aus der Base44-API). Lesen fuer alle eingeloggten Nutzer offen (harmlos,
    // reine Kartendaten), Schreiben nur fuer den Admin.
    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isCardAdmin();
    }

    // adminCardSync/{docId}: Sync-Reports + Review-Entscheidungen aus dem
    // Admin-Bereich. Komplett admin-only, auch lesend -- das sind interne
    // Arbeitsdaten (u.a. Rohtexte aus noch ungeprueften Aenderungen), keine
    // Spieldaten.
    match /adminCardSync/{docId} {
      allow read, write: if isCardAdmin();
    }
  }
}
